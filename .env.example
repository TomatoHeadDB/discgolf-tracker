SECRET_KEY=change-this-to-a-long-random-string
# Set to true once you're running behind HTTPS (e.g. via a reverse proxy
# like Nginx Proxy Manager). Makes session cookies HTTPS-only.
FORCE_HTTPS=false
# Uncomment and set to use Postgres/MySQL instead of the default SQLite file:
# DATABASE_URL=postgresql://user:password@localhost/discgolf
